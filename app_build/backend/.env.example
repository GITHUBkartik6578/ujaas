# Names only. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
MONGODB_URI=
SESSION_SECRET=
IP_HASH_SALT=
PUBLIC_BASE_URL=http://localhost:3000
MEDIA_DIR=./uploads
MEDIA_BASE_URL=/media
ENABLED_ROLES=site_admin
SUBMISSION_BODY_MAX=10000
# Retention (D-02): leave empty until the owner/legal decides. Empty = purge job disabled.
RETENTION_DAYS_SUBMISSIONS=
RETENTION_DAYS_CONTACT=
RETENTION_DAYS_LOGS=
TRUST_PROXY=0
LOG_LEVEL=info
ERROR_MONITORING_DSN=
# MAIL_* intentionally absent: email is off until D-06 is decided.
RATE_LIMIT_SCALE=1
